/*{
  "DESCRIPTION": "Dada gradiens",
  "CREDIT": "Dada VJ",
  "ISFVSN": "2",
  "CATEGORIES": ["Generator"],
  "INPUTS": [
    { "NAME": "speed", "TYPE": "float", "DEFAULT": 0.6, "MIN": 0.0, "MAX": 4.0 },
    { "NAME": "bands", "TYPE": "float", "DEFAULT": 7.0, "MIN": 1.0, "MAX": 24.0 },
    { "NAME": "tintA", "TYPE": "color", "DEFAULT": [0.05, 0.02, 0.25, 1.0] },
    { "NAME": "tintB", "TYPE": "color", "DEFAULT": [1.0, 0.35, 0.08, 1.0] }
  ]
}*/
void main() {
    vec2 uv = isf_FragNormCoord;
    float t = TIME * speed;
    float w = 0.5 + 0.5 * sin(uv.x * bands + t * 2.0)
                  * cos(uv.y * bands * 0.7 - t * 1.3);
    vec3 c = mix(tintA.rgb, tintB.rgb, w);
    float vign = 1.0 - 0.6 * length(uv - vec2(0.5));
    gl_FragColor = vec4(c * vign, 1.0);
}

