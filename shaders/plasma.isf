/*{
  "DESCRIPTION": "Dada plasma",
  "CREDIT": "Dada VJ",
  "ISFVSN": "2",
  "CATEGORIES": ["Generator"],
  "INPUTS": [
    { "NAME": "scale", "TYPE": "float", "DEFAULT": 5.0, "MIN": 0.5, "MAX": 20.0 },
    { "NAME": "speed", "TYPE": "float", "DEFAULT": 1.2, "MIN": 0.0, "MAX": 6.0 },
    { "NAME": "warp", "TYPE": "float", "DEFAULT": 1.7, "MIN": 0.0, "MAX": 5.0 }
  ]
}*/
void main() {
    vec2 uv = (isf_FragNormCoord - 0.5) * scale;
    float t = TIME * speed;
    float v = sin(uv.x + t);
    v += sin(uv.y * 1.3 - t * 0.7);
    v += sin((uv.x + uv.y + t) * 0.7);
    v += sin(length(uv) * warp - t * 1.1);
    v *= 0.25;
    vec3 c = vec3(sin(v * 3.14159), sin(v * 3.14159 + 2.09), sin(v * 3.14159 + 4.18));
    c = c * 0.5 + 0.5;
    gl_FragColor = vec4(c, 1.0);
}

