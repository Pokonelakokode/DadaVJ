/*{
    "DESCRIPTION": "RGB Glitch & Zoom Punch — színszétcsúszás, digitális szeletelés és ütés",
    "CREDIT": "Dada VJ",
    "ISFVSN": "2",
    "CATEGORIES": [ "Effect" ],
    "INPUTS": [
        { "NAME": "inputImage", "TYPE": "image" },
        { "NAME": "rgb_split", "TYPE": "float", "DEFAULT": 0.02, "MIN": 0.0, "MAX": 0.15 },
        { "NAME": "glitch", "TYPE": "float", "DEFAULT": 0.15, "MIN": 0.0, "MAX": 1.0 },
        { "NAME": "zoom_punch", "TYPE": "float", "DEFAULT": 0.0, "MIN": 0.0, "MAX": 0.8 },
        { "NAME": "slices", "TYPE": "float", "DEFAULT": 16.0, "MIN": 2.0, "MAX": 64.0 },
        { "NAME": "scanline", "TYPE": "float", "DEFAULT": 0.15, "MIN": 0.0, "MAX": 1.0 }
    ]
}*/

float hash(float n) {
    return fract(sin(n) * 43758.5453123);
}

void main() {
    vec2 uv = isf_FragNormCoord;
    // Zoom punch a középpont felé
    uv = (uv - 0.5) / (1.0 + zoom_punch) + 0.5;

    // Vízszintes glitch szeletelés
    float row = floor(uv.y * slices);
    float tick = floor(TIME * 18.0);
    float rnd = hash(row + tick * 13.7);
    float shift = (rnd - 0.5) * 0.25 * glitch * step(1.0 - glitch * 0.7, hash(row * 3.1 + tick));
    uv.x = clamp(uv.x + shift, 0.0, 1.0);

    vec2 dir = vec2(rgb_split, rgb_split * 0.35);
    float r = texture2D(inputImage, clamp(uv + dir, 0.0, 1.0)).r;
    float g = texture2D(inputImage, clamp(uv, 0.0, 1.0)).g;
    float b = texture2D(inputImage, clamp(uv - dir, 0.0, 1.0)).b;

    vec3 col = vec3(r, g, b);
    float scan = 1.0 - scanline * (0.5 + 0.5 * sin(isf_FragNormCoord.y * RENDERSIZE.y * 1.5));
    gl_FragColor = vec4(col * scan, 1.0);
}
