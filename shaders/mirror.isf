/*{
    "DESCRIPTION": "Tükrözés + lebegés — képi bemenettel (inputImage)",
    "CREDIT": "Dada VJ",
    "ISFVSN": "2",
    "CATEGORIES": [ "Effect" ],
    "INPUTS": [
        { "NAME": "inputImage", "TYPE": "image" },
        { "NAME": "amount", "TYPE": "float", "DEFAULT": 0.5, "MIN": 0.0, "MAX": 1.0 },
        { "NAME": "wobble", "TYPE": "float", "DEFAULT": 0.02, "MIN": 0.0, "MAX": 0.2 }
    ]
}*/

void main() {
    vec2 uv = isf_FragNormCoord;
    // Tükrözés a jobb oldalon.
    uv.x = mix(uv.x, 1.0 - uv.x, step(0.5, uv.x) * amount);
    // Lassú lebegés, hogy a kimenet időben változzon.
    uv.x += sin(TIME * 1.7) * wobble;
    uv.y += cos(TIME * 1.3) * wobble;
    gl_FragColor = texture2D(inputImage, clamp(uv, 0.0, 1.0));
}
