/*{
    "DESCRIPTION": "Tükrözés (Mirror) — irány, szög, távolság/zoom, középpont és lebegés",
    "CREDIT": "Dada VJ",
    "ISFVSN": "2",
    "CATEGORIES": [ "Effect" ],
    "INPUTS": [
        { "NAME": "inputImage", "TYPE": "image" },
        { "NAME": "distance", "TYPE": "float", "DEFAULT": 1.0, "MIN": 0.25, "MAX": 2.5 },
        {
            "NAME": "direction",
            "TYPE": "long",
            "DEFAULT": 0,
            "VALUES": [ 0, 1, 2, 3, 4, 5 ],
            "LABELS": [ "Bal -> Jobb", "Jobb -> Bal", "Fent -> Lent", "Lent -> Fent", "4-irányú (Quad)", "Átlós" ]
        },
        { "NAME": "angle", "TYPE": "float", "DEFAULT": 0.0, "MIN": -180.0, "MAX": 180.0 },
        { "NAME": "amount", "TYPE": "float", "DEFAULT": 1.0, "MIN": 0.0, "MAX": 1.0 },
        { "NAME": "wobble", "TYPE": "float", "DEFAULT": 0.01, "MIN": 0.0, "MAX": 0.2 },
        { "NAME": "center", "TYPE": "point2D", "DEFAULT": [ 0.5, 0.5 ], "MIN": 0.0, "MAX": 1.0 }
    ]
}*/

void main() {
    vec2 orig_uv = isf_FragNormCoord;
    vec2 p = (orig_uv - center) / max(distance, 0.05);

    float rad = angle * 0.0174532925;
    float cs = cos(rad);
    float sn = sin(rad);
    vec2 rot = vec2(p.x * cs - p.y * sn, p.x * sn + p.y * cs);

    if (direction < 0.5) {
        // Bal -> Jobb: a jobb oldal a bal oldal tükörképe
        rot.x = -abs(rot.x);
    } else if (direction < 1.5) {
        // Jobb -> Bal: a bal oldal a jobb oldal tükörképe
        rot.x = abs(rot.x);
    } else if (direction < 2.5) {
        // Fent -> Lent
        rot.y = -abs(rot.y);
    } else if (direction < 3.5) {
        // Lent -> Fent
        rot.y = abs(rot.y);
    } else if (direction < 4.5) {
        // 4-irányú (Quad)
        rot = -abs(rot);
    } else {
        // Átlós tükrözés
        if (rot.x > rot.y) {
            float tmp = rot.x;
            rot.x = rot.y;
            rot.y = tmp;
        }
    }

    vec2 unrot = vec2(rot.x * cs + rot.y * sn, -rot.x * sn + rot.y * cs);
    vec2 mirrored_uv = center + unrot;
    mirrored_uv.x += sin(TIME * 1.7 + orig_uv.y * 6.0) * wobble;
    mirrored_uv.y += cos(TIME * 1.3 + orig_uv.x * 6.0) * wobble;

    vec2 final_uv = mix(orig_uv, mirrored_uv, amount);
    // Tükörszerű csempézés a széleken, hogy nagy távolságnál se essen szét
    vec2 tiled = abs(fract(final_uv * 0.5 + 0.5) * 2.0 - 1.0);
    gl_FragColor = texture2D(inputImage, clamp(tiled, 0.0, 1.0));
}
