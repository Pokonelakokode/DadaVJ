/*{
    "DESCRIPTION": "Szín & Strobe Effekt — villantás (flash), invertálás, hue, telítettség, kontraszt",
    "CREDIT": "Dada VJ",
    "ISFVSN": "2",
    "CATEGORIES": [ "Effect" ],
    "INPUTS": [
        { "NAME": "inputImage", "TYPE": "image" },
        { "NAME": "flash", "TYPE": "float", "DEFAULT": 0.0, "MIN": 0.0, "MAX": 1.0 },
        { "NAME": "invert", "TYPE": "float", "DEFAULT": 0.0, "MIN": 0.0, "MAX": 1.0 },
        { "NAME": "hue_shift", "TYPE": "float", "DEFAULT": 0.0, "MIN": 0.0, "MAX": 1.0 },
        { "NAME": "saturation", "TYPE": "float", "DEFAULT": 1.0, "MIN": 0.0, "MAX": 3.0 },
        { "NAME": "contrast", "TYPE": "float", "DEFAULT": 1.0, "MIN": 0.2, "MAX": 3.0 },
        { "NAME": "posterize", "TYPE": "float", "DEFAULT": 0.0, "MIN": 0.0, "MAX": 1.0 },
        { "NAME": "flash_color", "TYPE": "color", "DEFAULT": [ 1.0, 1.0, 1.0, 1.0 ] }
    ]
}*/

vec3 rgb2hsv(vec3 c) {
    vec4 K = vec4(0.0, -1.0 / 3.0, 2.0 / 3.0, -1.0);
    vec4 p = mix(vec4(c.bg, K.wz), vec4(c.gb, K.xy), step(c.b, c.g));
    vec4 q = mix(vec4(p.xyw, c.r), vec4(c.r, p.yzx), step(p.x, c.r));
    float d = q.x - min(q.w, q.y);
    float e = 1.0e-10;
    return vec3(abs(q.z + (q.w - q.y) / (6.0 * d + e)), d / (q.x + e), q.x);
}

vec3 hsv2rgb(vec3 c) {
    vec4 K = vec4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
    vec3 p = abs(fract(c.xxx + K.xyz) * 6.0 - K.www);
    return c.z * mix(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y);
}

void main() {
    vec4 src = texture2D(inputImage, isf_FragNormCoord);
    vec3 col = src.rgb;

    // Hue & Saturation
    vec3 hsv = rgb2hsv(col);
    hsv.x = fract(hsv.x + hue_shift);
    hsv.y = clamp(hsv.y * saturation, 0.0, 1.0);
    col = hsv2rgb(hsv);

    // Contrast
    col = clamp((col - 0.5) * contrast + 0.5, 0.0, 1.0);

    // Posterize
    if (posterize > 0.01) {
        float steps = mix(32.0, 2.0, posterize);
        col = floor(col * steps + 0.5) / steps;
    }

    // Invert
    col = mix(col, 1.0 - col, invert);

    // Flash / Strobe
    col = mix(col, flash_color.rgb, clamp(flash, 0.0, 1.0));

    gl_FragColor = vec4(col, src.a);
}
